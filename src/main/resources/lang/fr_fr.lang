xinpga.help.title==== Aide du plugin XinPga ===
xinpga.help.start=/xpa start - Démarrer l'envoi planifié
xinpga.help.stop=/xpa stop - Arrêter l'envoi planifié
xinpga.help.multistart=/xpa multistart - Démarrer l'envoi d'annonces multi-thread (disponible uniquement en mode chat privé)
xinpga.help.multistop=/xpa multistop - Arrêter l'envoi d'annonces multi-thread
xinpga.help.string=/xpa string <numéro> <texte> - Définir le contenu d'envoi
xinpga.help.addmessage=/xpa addmessage <message> - Ajouter un message à la liste d'envoi
xinpga.help.removemessage=/xpa removemessage <message> - Supprimer un message de la liste d'envoi
xinpga.help.listmessages=/xpa listmessages - Lister tous les messages d'envoi
xinpga.help.time=/xpa time <secondes> - Définir l'intervalle d'envoi des annonces
xinpga.help.mode=/xpa mode <PUBLIC|PRIVATE> - Définir le mode d'envoi
xinpga.help.privateinterval=/xpa privateinterval <secondes> - Définir l'intervalle d'envoi des messages privés
xinpga.help.messageinterval=/xpa messageinterval <secondes> - Définir l'intervalle entre les messages
xinpga.help.randomsending=/xpa randomSending <on|off> - Définir le mode d'envoi aléatoire
xinpga.help.numberreplacement=/xpa numberreplacement <on|off> - Définir la fonction de remplacement de nombres
xinpga.help.minconsecutive=/xpa minconsecutive <nombre> - Définir le nombre minimum de chiffres consécutifs
xinpga.help.greeting=/xpa greeting <enable|disable> - Contrôler la fonction de salutation
xinpga.help.greeting.format=/xpa greeting format [format] - Modifier le format de salutation, utiliser #name# comme espace réservé pour le joueur
xinpga.help.updateplayerlist=/xpa updateplayerlist - Mettre à jour manuellement la liste des joueurs en ligne
xinpga.help.blacklist.add=/xpa blacklist add <joueur> - Ajouter un joueur à la liste noire de messages privés
xinpga.help.blacklist.remove=/xpa blacklist remove <joueur> - Supprimer un joueur de la liste noire de messages privés
xinpga.help.blacklist.list=/xpa blacklist list - Lister la liste noire de messages privés
xinpga.help.admin.add=/xpa admin add <joueur> - Ajouter un joueur à la liste des administrateurs
xinpga.help.admin.remove=/xpa admin remove <joueur> - Supprimer un joueur de la liste des administrateurs
xinpga.help.admin.list=/xpa admin list - Lister les administrateurs
xinpga.help.reload=/xpa reload - Recharger le fichier de configuration
xinpga.help.debug=/xpa debug - Afficher les informations du plugin
xinpga.help.help=/xpa help - Afficher cette aide
